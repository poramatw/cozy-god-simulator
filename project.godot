; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but can be edited easily using any text editor.

config_version=5

[application]

config/name="Chronicles of Morimar"
config/description="Cozy 2D Pixel Life & God Simulator (Desktop Edition)"
run/main_scene="res://src/world/MainWorld.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

DataManager="*res://src/autoload/DataManager.gd"
TimeManager="*res://src/autoload/TimeManager.gd"
KingdomManager="*res://src/autoload/KingdomManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="forward_plus"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.06, 0.10, 0.18, 1)
anti_aliasing/screen_space_roughness_limiter/enabled=false
