; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but can be edited easily using any text editor.

config_version=5

[application]

config/name="Chronicles of Morimar"
config/description="Cozy 2D Pixel Life & God Simulator"
run/main_scene="res://src/world/MainWorld.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

DataManager="*res://src/autoload/DataManager.gd"
TimeManager="*res://src/autoload/TimeManager.gd"
KingdomManager="*res://src/autoload/KingdomManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.08, 0.14, 0.22, 1)
